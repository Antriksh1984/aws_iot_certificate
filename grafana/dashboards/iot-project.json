    {
      "type": "table",
      "id": 12,
      "title": "What was blocked: AWS IoT log",
      "description": "Every denied action. 'certificate' is the real identity; 'claimedClientId' is what the device said it was. A rogue certificate claiming to be sensor-001 shows sensor-001 here but the rogue's certificate.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "iot-project-cloudwatch"
      },
      "gridPos": {
        "h": 9,
        "w": 15,
        "x": 9,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "iot-project-cloudwatch"
          },
          "queryMode": "Logs",
          "queryLanguage": "CWLI",
          "region": "default",
          "logGroupNames": [
            "AWSIotLogsV2"
          ],
          "expression": "fields @timestamp, clientId as claimedClientId, eventType as action, topicName as topic, reason, substr(principalId, 0, 10) as certificate\n| filter status = \"Failure\"\n| sort @timestamp desc\n| limit 100",
          "id": ""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__log__grafana_internal__": true,
              "__logstream__grafana_internal__": true
            },
            "renameByName": {
              "@timestamp": "time",
              "Time": "time"
            },
            "indexByName": {
              "@timestamp": 1,
              "Time": 0,
              "claimedClientId": 2,
              "certificate": 3,
              "action": 4,
              "topic": 5,
              "reason": 6
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reason"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "transparent"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "AUTHORIZATION_FAILURE": {
                        "text": "DENIED by policy",
                        "color": "red",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "certificate"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
